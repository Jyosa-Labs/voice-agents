generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Access control
  status     String    @default("pending") // 'pending' | 'approved' | 'rejected'
  approvedAt DateTime?
  approvedBy String?   // email of admin who approved, or 'auto:admin' for ADMIN_EMAILS

  accounts       Account[]
  sessions       Session[]
  agentInstances AgentInstance[]
  conversations  Conversation[]
  usageEvents    UsageEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Stores the ElevenLabs agent ID created per user per agent type
model AgentInstance {
  id                String   @id @default(cuid())
  userId            String
  agentKey          String
  elevenlabsAgentId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentKey])
}

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  agentKey   String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  ttfbMs     Int?

  // Identity snapshot at session time (denormalized so deletes don't lose history)
  userName   String?
  userEmail  String?
  userImage  String?

  // Where they used it from
  ipAddress  String?
  country    String?
  city       String?
  region     String?
  userAgent  String? @db.Text

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  text           String   @db.Text
  createdAt      DateTime @default(now())
  latencyMs      Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  agentKey  String
  eventType String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
